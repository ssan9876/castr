[Unit]
Description=castr screen receiver
After=network-online.target sound.target systemd-modules-load.service
Wants=network-online.target

[Service]
User=castr
Group=castr
SupplementaryGroups=video render input audio
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=XDG_CONFIG_HOME=/var/lib/castr/config
# Wait (bounded) for the DRM device and the V4L2 codec device on early boot.
# The loops live in a separate script because unit files must not contain a
# literal `$` - systemd substitutes $WORD tokens before the shell sees them.
# `-`: a missing or unexecutable wait script must not stop the receiver from
# starting; the script itself exits 0 regardless of what it finds.
ExecStartPre=-/usr/local/lib/castr/wait-devices.sh
TimeoutStartSec=30
# The Miracast sink starts a supplicant, addresses the group interface, binds
# DHCP on port 67 and binds that socket to the group device. Those need
# NET_ADMIN, NET_BIND_SERVICE and NET_RAW respectively; nothing else here does.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
ExecStart=/usr/local/bin/castr-receiver --fullscreen
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
